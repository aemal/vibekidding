# Copy into local environment configuration; never commit real secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Supabase auth UUIDs, never email addresses or browser-supplied roles
STUDIO_ADMIN_USER_IDS=
# Enable only after the consent, provider terms, child privacy, retention and deletion review below.
STUDIO_CHILD_SAFETY_APPROVED=false
RESEND_API_KEY=
STUDIO_MAIL_FROM=
# Reserved for a future server-owned metered voice relay. These do not enable voice today.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# GuardLoop / TypeSafe: required for typed generation. Use a model verified via TypeSafe /v1/models.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=
# Reviewed worst-case micro-USD cost per bounded safety evaluation; held until provider reconciliation.
TYPESAFE_MAX_CHECK_MICRO_USD=

# Server-only scheduler authentication, at least 32 random characters.
# Configure your deployment scheduler to POST /api/studio/notifications/run.
STUDIO_WORKER_SECRET=
# Resend webhook signing secret for /api/studio/notifications/webhook.
RESEND_WEBHOOK_SECRET=
# Keep disabled until isolated execution and the authenticated parent bridge are reviewed.
STUDIO_PUBLISHED_STORAGE_ENABLED=false
