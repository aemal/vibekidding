map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80 default_server;
    server_name ${BASE_DOMAIN};
    set $public_mode ${VIBEKIDDING_PUBLIC_MODE};
    add_header Origin-Agent-Cluster "?1" always;
    client_max_body_size 20m;
    resolver 127.0.0.11 valid=10s ipv6=off;

    location = /healthz {
        access_log off;
        return 200 'ok\n';
        add_header Content-Type text/plain;
    }

    # Published app URLs. The controller resolves only registered deployments.
    location ^~ /apps/ {
        if ($public_mode = 1) { return 404; }
        set $runtime http://controller:4000;
        proxy_pass $runtime;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # Studio API owns authenticated lifecycle requests. Controller management
    # endpoints are deliberately not exposed through the public gateway.
    location / {
        set $studio http://studio:3000;
        proxy_pass $studio;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}

# Generated applications never receive studio pages or authenticated API routes.
# Exact hostname takes precedence over the studio wildcard server above.
server {
    listen 80;
    server_name ~^(?<runtime_project>[a-z0-9][a-z0-9-]*)\.apps\.(?<runtime_base>.+)$;
    if ($runtime_base != "${BASE_DOMAIN}") { return 404; }
    add_header Origin-Agent-Cluster "?1" always;
    client_max_body_size 20m;
    resolver 127.0.0.11 valid=10s ipv6=off;
    location = /healthz { return 200 'ok\n'; }
    location ^~ /apps/ {
        # Controller independently checks that this host matches the path ID.
        set $runtime http://controller:4000;
        proxy_pass $runtime;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
    location / { return 404; }
}

server {
    listen 80;
    server_name apps.${BASE_DOMAIN};
    location = /healthz { return 200 'ok\n'; }
    location / { return 404; }
}
