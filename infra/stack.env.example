# Copy with bootstrap.sh; do not commit the real file.
BASE_DOMAIN=localhost
PUBLIC_PORT=3000
BIND_ADDRESS=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000
VIBEKIDDING_RUNTIME_ORIGIN=http://apps.localhost:3000
VIBEKIDDING_PUBLIC_MODE=0
VIBEKIDDING_PUBLIC_SCHEME=http
VIBEKIDDING_CONTROLLER_TOKEN=
# Optional email OTP and external provider-encryption key. Keep keys private.
VIBEKIDDING_INVITED_EMAILS=
RESEND_API_KEY=
STUDIO_MAIL_FROM=
VIBEKIDDING_PROVIDER_ENCRYPTION_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VIBEKIDDING_SAMANTHA_DEMO_ENABLED=0
SAMANTHA_API_KEY=
SAMANTHA_AGENT_ID=
VIBEKIDDING_APP_MEMORY=512m
VIBEKIDDING_APP_CPUS=1
VIBEKIDDING_BUILD_TIMEOUT_MS=600000

# Optional one-click access for a loopback-only, single-account test installation.
VIBEKIDDING_LOCAL_TEST_ACCESS=0
