# Login-free workshop: npm run dev:demo (templates, no credentials needed).
# Full account-based studio configuration is in .env.studio.example.

# Optional local AI: npm run dev:demo-ai
OPENAI_API_KEY=
# Alternative provider; a working funded account is required.
ANTHROPIC_API_KEY=

# Optional local Samantha conversation. See README before creating a new agent.
VIBEKIDDING_SAMANTHA_API_KEY=
VIBEKIDDING_SAMANTHA_AGENT_ID=
VIBEKIDDING_SAMANTHA_DEMO_ENABLED=0

# Optional hosted reader offered when sharing a local AI creation.
# Set only after /demo/play is deployed at this origin. This value is public.
NEXT_PUBLIC_DEMO_SHARE_ORIGIN=

# Historical V1 SQLite development setting; not needed for the workshop.
DATABASE_URL="file:./dev.db"
